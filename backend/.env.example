# Backend runtime configuration. Keep all secrets in the hosting provider's secret manager.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rwa_intelligence

# Registry administration
REGISTRY_ADMIN_TOKEN=generate-a-long-random-server-secret

# CoinGecko provider configuration
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3

# Frontend server-side API connection (local development)
RWA_API_BASE_URL=http://127.0.0.1:8000